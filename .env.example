# Cosmos Atlas — Variables de entorno (ejemplo)
# Renombra a .env.local para desarrollo local.

# CelesTrak — TLEs de satélites
NEXT_PUBLIC_CELESTRAK_ISS_URL=https://celestrak.org/NORAD/elements/gp.php?CATNR=25544&FORMAT=tle
NEXT_PUBLIC_CELESTRAK_STARLINK_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=starlink&FORMAT=tle

# CDS Sesame — resolución de nombres de objetos celestes (SIMBAD/NED/VizieR)
NEXT_PUBLIC_SESAME_URL=https://cdsweb.u-strasbg.fr/cgi-bin/nph-sesame/-oIJ/A

# Supabase — catálogo enriquecido de Cosmos Atlas (opcional pero recomendado en producción)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IA Astronómica server-side (opcional). No expongas esta clave con NEXT_PUBLIC.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Rate limit distribuido para /api/astronomer en serverless (opcional, recomendado en produccion)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
