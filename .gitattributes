# Cosmos Atlas – Git line-ending policy
# Ensures all text files are stored in LF in the repo regardless of OS.
# Developers on Windows keep their local copies in CRLF (eol=crlf in git config)
# but Git normalises to LF on commit, so diffs stay clean.

* text=auto eol=lf

# Explicitly text files
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.html  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.env*  text eol=lf

# Binary – never touch line endings
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.mp3   binary
*.mp4   binary
*.webm  binary
*.glb   binary
*.gltf  text eol=lf
